# Copy to .env.deploy and fill in the values before starting the deployment.
# Node addresses must be reachable from containers; loopback refers to the container.
HUBURL=
# Optional: defaults to HUBURL when blank.
FREECAST_FEED_HTTP_URL=
# Use http:// for plaintext gRPC or https:// for TLS.
FREECAST_FEED_GRPC_URL=
FREECAST_PUBLIC_URL=https://kite.example.com
# Host port for a reverse proxy on this machine; bound to loopback only.
PORT=3000

# The bundled database uses this password. Compose sets DATABASE_URL and PGPASSWORD
# for web and worker automatically; no external database URL is needed in this stack.
FREECAST_POSTGRES_PASSWORD=
FREECAST_FEED_FIDS=37
FREECAST_FEED_HISTORY_DAYS=30
FREECAST_FEED_MAX_USERS=1000

OPTIMISM_RPC_URL=https://mainnet.optimism.io
# Optional: the app account's FID and mnemonic enable approval links and QR codes.
FARCASTER_APP_FID=
FARCASTER_APP_MNEMONIC=
# Optional: enables image uploads. GIF search needs no extra API key.
IMGBB_API_KEY=
