# Reads go to your own node. Keep remote endpoints in your ignored local .env.
NEXT_PUBLIC_HUBURL=http://127.0.0.1:3381
# A read node cannot accept writes. Supply a validator's HTTP URL separately.
VALIDATOR_URL=
OPTIMISM_RPC_URL=https://mainnet.optimism.io
PORT=5173

# Optional Farcaster approval link/QR flow. These are server-only credentials.
FARCASTER_APP_FID=
FARCASTER_APP_MNEMONIC=
# Alternatively, point to an operator-selected existing app .env containing
# DEVELOPER_FID and DEVELOPER_MNEMONIC. Other settings are not imported.
FARCASTER_APP_ENV_FILE=
# Set when serving behind an HTTPS reverse proxy; include the full public origin.
FREECAST_PUBLIC_URL=
# Optional direct HTTPS listener for `npm start` (certificate files stay local).
FREECAST_TLS_CERT=
FREECAST_TLS_KEY=
# Defaults to loopback; use 0.0.0.0 to expose a direct test listener.
FREECAST_HOST=127.0.0.1
