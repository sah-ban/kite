# Reads and signed submissions use the same node HTTP API.
# Keep node endpoints in your ignored local .env.
NEXT_PUBLIC_HUBURL=http://127.0.0.1:3381
OPTIMISM_RPC_URL=https://mainnet.optimism.io
PORT=5173

# Optional Farcaster approval link/QR flow. These are server-only credentials.
FARCASTER_APP_FID=
FARCASTER_APP_MNEMONIC=
# Alternatively, point to an operator-selected existing app .env containing
# DEVELOPER_FID and DEVELOPER_MNEMONIC. Other settings are not imported.
FARCASTER_APP_ENV_FILE=
# Set when serving behind an HTTPS reverse proxy; include the full public origin.
FREECAST_PUBLIC_URL=
# Optional direct HTTPS listener for `npm start` (certificate files stay local).
FREECAST_TLS_CERT=
FREECAST_TLS_KEY=
# Defaults to loopback; use 0.0.0.0 to expose a direct test listener.
FREECAST_HOST=127.0.0.1

# Encrypted signer sessions and their generated server key (ignored local storage).
FREECAST_SESSION_DIR=.freecast/sessions

# Optional server-only ImgBB image uploads. Never use a NEXT_PUBLIC_ or VITE_ key.
IMGBB_API_KEY=

# Indexed Following feed (server-only). Leave unset to keep direct node reads.
# Start PostgreSQL with: docker compose -p freecast -f compose.feed.yml up -d
FREECAST_POSTGRES_PASSWORD=
DATABASE_URL=
# Optional seed viewers; the first supplies the signed-out following feed preview.
# Verified connected accounts enroll automatically.
FREECAST_FEED_FIDS=37
FREECAST_FEED_MAX_USERS=1000
# Node HTTP API and gRPC API; TLS uses https, plaintext uses http.
FREECAST_FEED_HTTP_URL=http://127.0.0.1:3381
FREECAST_FEED_GRPC_URL=http://127.0.0.1:3383
FREECAST_FEED_HISTORY_DAYS=30
