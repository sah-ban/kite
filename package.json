    "@grpc/grpc-js": "^1.14.6",
    "hls.js": "1.7.3",
    "htmlparser2": "12.0.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.4",
